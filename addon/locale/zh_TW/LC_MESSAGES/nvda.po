msgid "Move focus to chat list"
msgstr "將焦點移至聊天室清單"

msgid "Open main menu"
msgstr "開啟主選單"

msgid "Switch chats and announce the chat name"
msgstr "切換聊天室並朗讀聊天室名稱"

msgid "Chat list not found"
msgstr "找不到聊天室清單"

msgid "Chat list is empty"
msgstr "聊天室清單是空的"

msgid "Main menu is not available"
msgstr "主選單無法使用"

msgid "Main menu"
msgstr "主選單"

msgid "Profile"
msgstr "個人資料"

msgid "Accounts"
msgstr "帳號"

msgid "Emoji, stickers, and GIFs"
msgstr "表情符號、貼圖和 GIF"

msgid "Record voice message"
msgstr "錄製語音訊息"

